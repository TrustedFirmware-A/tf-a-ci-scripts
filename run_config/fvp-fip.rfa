pre_tf_build() {
	# Only build bl1 and bl2 targets for this config
	targets="bl1 bl2" set_tf_build_targets
}

post_rfa_archive() {
	local fip_args=(BL33="$archive/bl33.bin")

	if [ -f "$archive/bl32.bin" ]; then
		fip_args+=(BL32="$archive/bl32.bin")
	fi

	if [ -f "$archive/stf_rmm.bin" ]; then
		fip_args+=(RMM="$archive/stf_rmm.bin")
	fi

	build_fip "${fip_args[@]}"
	archive_file "$tf_build_root/fvp/${bin_mode}/fip.bin"

	fiptool=$(fiptool_path)
	"$fiptool" update \
		--soc-fw "$archive/bl31.bin" \
		--out "$archive/fip.bin" \
		"$archive/fip.bin"
}
